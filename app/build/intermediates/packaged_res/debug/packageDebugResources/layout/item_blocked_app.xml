<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Top row: icon, name, open count, remove button -->
        <LinearLayout
            android:id="@+id/row_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="14dp"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/iv_icon"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:scaleType="centerCrop"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tv_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOnSurface"/>

                <TextView
                    android:id="@+id/tv_open_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:textColor="?attr/colorOutline"/>

            </LinearLayout>

            <ImageButton
                android:id="@+id/btn_remove"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_delete"
                android:tint="?attr/colorOutline"/>

        </LinearLayout>

        <!-- Expandable usage stats section -->
        <LinearLayout
            android:id="@+id/usage_stats_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingBottom="14dp"
            android:visibility="gone">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/colorOutlineVariant"
                android:layout_marginBottom="10dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SCREEN TIME (LAST 7 DAYS)"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:fontFamily="monospace"
                android:textColor="?attr/colorOutline"
                android:layout_marginBottom="8dp"/>

            <!-- Day 1 (most recent) -->
            <include layout="@layout/item_usage_bar" android:id="@+id/bar_day1"/>
            <include layout="@layout/item_usage_bar" android:id="@+id/bar_day2"/>
            <include layout="@layout/item_usage_bar" android:id="@+id/bar_day3"/>
            <include layout="@layout/item_usage_bar" android:id="@+id/bar_day4"/>
            <include layout="@layout/item_usage_bar" android:id="@+id/bar_day5"/>
            <include layout="@layout/item_usage_bar" android:id="@+id/bar_day6"/>
            <include layout="@layout/item_usage_bar" android:id="@+id/bar_day7"/>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
