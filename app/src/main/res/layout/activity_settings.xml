<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface">

    <!-- Top bar -->
    <LinearLayout
        android:id="@+id/top_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="24dp"
        android:paddingTop="40dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_arrow_back"
            android:tint="?attr/colorOnSurface"
            android:contentDescription="Back"/>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Settings"
            android:textSize="26sp"
            android:fontFamily="serif"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="4dp"/>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="96dp"
        android:paddingBottom="32dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp">

            <!-- ── BLOCKING BEHAVIOUR ── -->
            <include layout="@layout/settings_section_header" android:id="@+id/header_blocking"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Countdown duration -->
                    <LinearLayout
                        android:id="@+id/row_countdown"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Countdown duration" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                            <TextView android:id="@+id/tv_countdown_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="5 seconds" android:textSize="12sp" android:textColor="?attr/colorOutline" android:fontFamily="monospace"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <!-- Allow opening after countdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Allow opening after countdown" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="If off, app is always blocked" android:textSize="12sp" android:textColor="?attr/colorOutline" android:fontFamily="monospace"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_allow_open" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#FF6B6B" app:trackTint="?attr/colorOutlineVariant"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <!-- Block on weekends -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Block on weekends" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Sat &amp; Sun" android:textSize="12sp" android:textColor="?attr/colorOutline" android:fontFamily="monospace"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_block_weekends" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#FF6B6B" app:trackTint="?attr/colorOutlineVariant"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <!-- Scheduled blocking -->
                    <LinearLayout
                        android:id="@+id/row_schedule"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:padding="16dp"
                        android:background="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Scheduled blocking windows" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coming soon" android:textSize="12sp" android:textColor="?attr/colorOutline" android:fontFamily="monospace"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── STATS & AWARENESS ── -->
            <include layout="@layout/settings_section_header" android:id="@+id/header_stats"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Show daily open count on cards" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_show_open_count" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#FF6B6B" app:trackTint="?attr/colorOutlineVariant"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Weekly usage report notification" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_weekly_report" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#FF6B6B" app:trackTint="?attr/colorOutlineVariant"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:id="@+id/row_reset_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reset stats" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Daily / Weekly / All time" android:textSize="12sp" android:textColor="?attr/colorOutline" android:fontFamily="monospace"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── APPEARANCE ── -->
            <include layout="@layout/settings_section_header" android:id="@+id/header_appearance"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Dark mode" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                        </LinearLayout>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_dark_mode" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#FF6B6B" app:trackTint="?attr/colorOutlineVariant"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:id="@+id/row_accent_color" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Accent color" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coming soon" android:textSize="12sp" android:textColor="?attr/colorOutline" android:fontFamily="monospace"/>
                        </LinearLayout>
                        <View android:layout_width="24dp" android:layout_height="24dp" android:background="#FF6B6B" android:layout_marginEnd="8dp"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── NOTIFICATIONS ── -->
            <include layout="@layout/settings_section_header" android:id="@+id/header_notifs"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Daily morning reminder" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_daily_reminder" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#FF6B6B" app:trackTint="?attr/colorOutlineVariant"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Weekly summary notification" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                        <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/switch_weekly_summary" android:layout_width="wrap_content" android:layout_height="wrap_content" app:thumbTint="#FF6B6B" app:trackTint="?attr/colorOutlineVariant"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:id="@+id/row_notif_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Notification time" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                            <TextView android:id="@+id/tv_notif_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8:00 AM" android:textSize="12sp" android:textColor="?attr/colorOutline" android:fontFamily="monospace"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── APP MANAGEMENT ── -->
            <include layout="@layout/settings_section_header" android:id="@+id/header_management"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:id="@+id/row_pause_blocking" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Pause all blocking" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                            <TextView android:id="@+id/tv_pause_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="30 min / 1 hr / custom" android:textSize="12sp" android:textColor="?attr/colorOutline" android:fontFamily="monospace"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:id="@+id/row_export" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Import / Export blocked apps" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coming soon" android:textSize="12sp" android:textColor="?attr/colorOutline" android:fontFamily="monospace"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:id="@+id/row_biometric" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="?attr/selectableItemBackground">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="PIN / Biometric lock" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Coming soon" android:textSize="12sp" android:textColor="?attr/colorOutline" android:fontFamily="monospace"/>
                        </LinearLayout>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── ABOUT ── -->
            <include layout="@layout/settings_section_header" android:id="@+id/header_about"/>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="32dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="?attr/colorOutlineVariant">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="App version" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                        <TextView android:id="@+id/tv_version" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="12sp" android:fontFamily="monospace" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:id="@+id/row_rate" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Rate the app ⭐" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:id="@+id/row_privacy" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Privacy policy" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/colorOutlineVariant" android:layout_marginStart="16dp" android:layout_marginEnd="16dp"/>

                    <LinearLayout android:id="@+id/row_feedback" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp" android:background="?attr/selectableItemBackground">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Send feedback" android:textSize="14sp" android:textColor="?attr/colorOnSurface"/>
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="›" android:textSize="20sp" android:textColor="?attr/colorOutline"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
